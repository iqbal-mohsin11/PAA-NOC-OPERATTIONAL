# PAA Sentinel v5.0 Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# MongoDB Database Connection String
# For Local PC MongoDB Community Server (default local port 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/paa_sentinel

# For MongoDB Atlas Cloud (Optional):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/paa_sentinel?retryWrites=true&w=majority

# Gemini API Key (Optional AI Features)
GEMINI_API_KEY=
